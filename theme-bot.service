[Unit]
Description=Discord Theme Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USERNAME
WorkingDirectory=/home/YOUR_LINUX_USERNAME/theme-bot

# Must be the venv interpreter: the bot resolves yt-dlp relative to
# sys.executable, so a system python would silently use a different yt-dlp.
ExecStart=/home/YOUR_LINUX_USERNAME/theme-bot/venv/bin/python bot1.py

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
